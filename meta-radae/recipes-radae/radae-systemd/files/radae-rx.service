[Unit]
Description=RADAE HF Voice Codec (RX Only)
Documentation=man:radae(1)
After=network.target sound.target
Requires=sound.target

[Service]
Type=simple
User=radae
Group=radae
SupplementaryGroups=audio

EnvironmentFile=/etc/radae/radae-env

ExecStartPre=/usr/bin/chrt -f -p 80 $$
ExecStart=/usr/bin/radae-rx --config /etc/radae/radae.conf

Restart=on-failure
RestartSec=5s

LimitRTPRIO=95
LimitMEMLOCK=infinity
Nice=-10
CPUAffinity=0 1 2 3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/radae /run/radae

DeviceAllow=/dev/snd rw

StandardOutput=journal
StandardError=journal
SyslogIdentifier=radae-rx

[Install]
WantedBy=multi-user.target
