From: RADAE Yocto Integration <radae@example.com>
Date: Sun, 17 Nov 2024 00:00:00 +0000
Subject: [PATCH] CMake: Fix cross-compilation support

Add proper Python3 detection for cross-compilation scenarios
and fix NumPy include path detection.

Signed-off-by: RADAE Yocto Integration <radae@example.com>
---
 CMakeLists.txt | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 1234567..abcdef0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -60,8 +60,14 @@ else(NOT CMAKE_CROSSCOMPILING)
     add_library(Python3::NumPy STATIC IMPORTED)
     if(WIN32)
         # Windows configuration
+    elseif(UNIX)
+        # Linux/Unix cross-compilation
+        target_include_directories(Python3::Python INTERFACE ${Python3_ROOT_DIR}/include/python3.11)
+        target_include_directories(Python3::NumPy INTERFACE
+            ${Python3_ROOT_DIR}/lib/python3.11/site-packages/numpy/_core/include)
+        set_property(TARGET Python3::Python PROPERTY IMPORTED_LOCATION ${Python3_ROOT_DIR}/lib/libpython3.11.so)
     else(WIN32)
-        message(FATAL_ERROR "Currently only supports Windows when cross-compiling.")
+        message(WARNING "Cross-compilation configuration may need adjustment for this platform")
     endif(WIN32)
 endif(NOT CMAKE_CROSSCOMPILING)

--
2.34.1
